rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar se é um administrador autenticado
    function isAdmin() {
      return request.auth != null && request.auth.token.email != null;
    }

    // AGENDAMENTOS
    match /bookings/{bookingId} {
      // 1. Visitante cria agendamento com campos válidos
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 30
                    && request.resource.data.date is string
                    && request.resource.data.time is string;
      
      // 2. Proteção contra vazamento: NINGUÉM pode listar/baixar todos os agendamentos, apenas o Admin.
      allow list: if isAdmin();
      
      // 3. O cliente que possui o link/ID do agendamento pode visualizar seu próprio orçamento.
      allow get: if true;
      
      // 4. Atualização: Admin pode tudo. Cliente público pode APENAS aprovar ou cancelar (mudar status).
      allow update: if isAdmin() 
                    || (
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                      && request.resource.data.status in ['confirmed', 'cancelled', 'quote_sent']
                    );
      
      // 5. Apenas Admin pode deletar
      allow delete: if isAdmin();
    }

    // HORÁRIOS OCUPADOS (PÚBLICO - ZERO DADOS PESSOAIS DE CLIENTES)
    // Contém apenas: { date: "2026-09-04", time: "10:00 AM", status: "booked" }
    // Permite que qualquer celular/navegador veja horários ocupados e previna duplicidade em tempo real
    match /booked_slots/{slotId} {
      allow read, create, update, delete: if true;
    }

    // MENSAGENS DE CONTATO
    match /messages/{messageId} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string 
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 2000;
      
      allow read, update, delete: if isAdmin();
    }

    // CONFIGURAÇÕES (Agenda e Preços)
    match /config/{configDoc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // GALERIA DE FOTOS
    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
