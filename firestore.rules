rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Função auxiliar: apenas os administradores cadastrados no Firebase Auth
    function isAdmin() {
      return request.auth != null && request.auth.token.email != null;
    }

    // 2. AGENDAMENTOS (DADOS PESSOAIS PRIVADOS DOS CLIENTES)
    match /bookings/{bookingId} {
      // Criação inicial: visitante cria agendamento com validação rígida de campos e clientToken obrigatório
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 30
                    && request.resource.data.date is string
                    && request.resource.data.time is string
                    && request.resource.data.clientToken is string
                    && request.resource.data.clientToken.size() >= 16;
      
      // BLINDAGEM MÁXIMA DE LEITURA (Anti-Vazamento de PII):
      // NENHUM visitante ou terceiro pode ler documentos de agendamento (nem 'get' nem 'list')!
      // Mesmo se o ID for descoberto ou vazado, o Firestore BLOQUEIA qualquer leitura pública.
      // Apenas os administradores autenticados podem ler os dados dos clientes.
      allow read: if isAdmin();
      
      // ATUALIZAÇÃO SEGURA (Anti-Adulteração de Status):
      // Admin pode atualizar qualquer campo.
      // O cliente público SÓ consegue aprovar ou cancelar SE fornecer exatamente o clientToken secreto gerado no agendamento e enviado no seu e-mail pessoal!
      allow update: if isAdmin() 
                    || (
                      request.resource.data.clientToken == resource.data.clientToken
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'clientToken'])
                      && request.resource.data.status in ['confirmed', 'cancelled']
                    );
      
      // EXCLUSÃO: Apenas administradores
      allow delete: if isAdmin();
    }

    // 3. HORÁRIOS OCUPADOS (PÚBLICO - ZERO DADOS PESSOAIS DE CLIENTES)
    // Contém APENAS: date, time, status: 'booked', bookingId
    // Permite consulta pública sem vazar nenhum dado de cliente
    match /booked_slots/{slotId} {
      // Leitura pública dos horários ocupados para desativar botões na interface
      allow read: if true;

      // Criação restrita: visitante SÓ pode reservar se o horário NÃO estiver ocupado ainda (previne sobrescrita e duplicidade)
      allow create: if !exists(/databases/$(database)/documents/booked_slots/$(slotId))
                    && request.resource.data.date is string
                    && request.resource.data.time is string
                    && request.resource.data.status == 'booked'
                    && request.resource.data.bookingId is string;

      // BLOQUEIO CONTRA VANDALISMO: Visitantes NÃO podem alterar nem apagar os horários da agenda!
      // Apenas administradores podem alterar ou liberar horários no banco.
      allow update, delete: if isAdmin();
    }

    // 4. MENSAGENS DE CONTATO
    match /messages/{messageId} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string 
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 2000;
      
      allow read, update, delete: if isAdmin();
    }

    // 5. CONFIGURAÇÕES (Agenda e Preços)
    match /config/{configDoc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. GALERIA DE FOTOS
    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
