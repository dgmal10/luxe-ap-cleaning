rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Agendamentos: Visitantes podem criar com validação estrita de tamanho e tipo, mas APENAS o admin autenticado pode ler/editar/excluir
    match /bookings/{bookingId} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 30
                    && request.resource.data.date is string
                    && request.resource.data.time is string;
      allow read, update, delete: if request.auth != null;
    }

    // Mensagens de Contato: Visitantes podem enviar com validação de campos, mas APENAS o admin autenticado pode ler/excluir
    match /messages/{messageId} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string 
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if request.auth != null;
    }

    // Configurações de Agenda: Público pode ler para ver horários disponíveis, apenas admin autenticado pode alterar
    match /config/schedule {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Configurações de Preços: Público pode ler para cálculos, apenas admin autenticado pode alterar
    match /config/pricing {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Galeria: Público pode visualizar fotos, apenas admin autenticado pode cadastrar/excluir
    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
